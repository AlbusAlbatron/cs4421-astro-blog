---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(960px, calc(100% - 2em));
			}
			.project-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
				gap: 2rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.project-list > li {
				min-width: 0;
			}
			.project-list img {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				margin-bottom: 1rem;
				border-radius: 8px;
			}
			.project-link {
				color: inherit;
				text-decoration: none;
			}
			.title {
				margin: 0 0 0.5rem;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.project-link:hover .title {
				color: rgb(var(--accent));
			}
			.date {
				margin: 0 0 0.75rem;
				color: rgb(var(--gray));
			}
			.description {
				margin: 0 0 0.75rem;
			}
			.stack,
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.stack {
				margin-bottom: 0.75rem;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
			}
			.links a {
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="project-list">
					{projects.map((project) => (
						<li>
							<a class="project-link" href={`/projects/${project.id}/`}>
								{project.data.heroImage && (
									<Image
										width={720}
										height={405}
										src={project.data.heroImage}
										alt={project.data.heroImageAlt ?? project.data.title}
									/>
								)}
								<h2 class="title">{project.data.title}</h2>
							</a>
							<p class="date"><FormattedDate date={project.data.date} /></p>
							<p class="description">{project.data.description}</p>
							{project.data.stack.length > 0 && (
								<ul class="stack" aria-label="Technologies used">
									{project.data.stack.map((technology) => <li>{technology}</li>)}
								</ul>
							)}
							<ul class="links" aria-label="Project links">
								<li><a href={project.data.repoUrl} target="_blank" rel="noreferrer">Source code</a></li>
								{project.data.demoUrl && (
									<li><a href={project.data.demoUrl} target="_blank" rel="noreferrer">Live demo</a></li>
								)}
							</ul>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>